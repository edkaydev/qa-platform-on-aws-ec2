# QAAI environment — copy to .env and replace every CHANGE_ME value.
# Never commit .env. Generate secrets with: openssl rand -hex 32

ENVIRONMENT=production
TZ=Africa/Kampala

# ---------------------------------------------------------------------------
# MySQL (used by docker compose to initialise the database)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=qaai
MYSQL_USER=qaai
MYSQL_PASSWORD=CHANGE_ME_database_password

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# DATABASE_URL is assembled by docker-compose.yml from the MySQL values above.
SECRET_KEY=CHANGE_ME_64_character_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=https://quality-assurance-ai.duckdns.org
ENABLE_DOCS=false
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Local AI (Ollama runs on the host, not inside compose)
# ---------------------------------------------------------------------------
AI_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:270m
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=400

# ---------------------------------------------------------------------------
# Voice transcription (faster-whisper, runs inside the backend container)
# ---------------------------------------------------------------------------
WHISPER_ENABLED=true
WHISPER_MODEL=tiny
MAX_AUDIO_BYTES=20000000

# ---------------------------------------------------------------------------
# Seeded reviewer account — change before the first seed in production
# ---------------------------------------------------------------------------
SEED_REVIEWER_EMAIL=reviewer@qaai.local
SEED_REVIEWER_PASSWORD=CHANGE_ME_reviewer_password
SEED_REVIEWER_NAME=QAAI Reviewer

# Public URL for this deployment (documentation / CORS):
# https://quality-assurance-ai.duckdns.org
